# Copy file này thành .env.local rồi điền giá trị thật.
# .env.local KHÔNG BAO GIỜ được commit (đã nằm trong .gitignore).

# ---------- Supabase (Dashboard > Project Settings > API) ----------

# URL project Supabase, dạng https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Khóa anon/public — an toàn để lộ ra client vì đã có RLS bảo vệ dữ liệu.
# TUYỆT ĐỐI không dùng service_role key ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khóa service_role — BỎ QUA toàn bộ RLS, CHỈ dùng phía server.
# Không có tiền tố NEXT_PUBLIC_ nên không bao giờ lọt vào bundle trình duyệt.
# Dùng để tạo tài khoản thành viên qua Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Email (https://resend.com/api-keys) ----------

# API key của Resend, dùng để gửi email chào mừng thành viên mới.
RESEND_API_KEY=

# Địa chỉ gửi. Khi test dùng onboarding@resend.dev;
# khi chạy thật phải là địa chỉ thuộc domain đã xác thực trên Resend.
EMAIL_FROM=onboarding@resend.dev

# ---------- Tùy chọn ----------

# URL công khai của site, dùng cho link và logo trong email.
# Để trống thì hệ thống tự lấy origin của request.
NEXT_PUBLIC_SITE_URL=
