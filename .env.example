# Copy file này thành .env.local rồi điền giá trị thật.
# Lấy từ: Supabase Dashboard > Project Settings > API

# URL project Supabase, dạng https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Khóa anon/public — an toàn để lộ ra client vì đã có RLS bảo vệ dữ liệu.
# TUYỆT ĐỐI không dùng service_role key ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
